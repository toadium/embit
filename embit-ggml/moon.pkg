// embit-ggml：全尺度 VLA 推理 SDK
// 封装 ggml/vla.cpp，提供统一多模态推理接口，支持 1B~70B+ 模型，INT4~FP16 全精度。
// 通过 native-stub 编译 C 桥接代码，FFI 通道仅支持 native 后端。
//
// 条件编译架构：
//   - 默认（无 EMBIT_HAS_GGML）：占位回退，推理仅记录计数，动作序列由 MoonBit 侧生成
//   - 启用（EMBIT_HAS_GGML）：调用真实 ggml/VLA C 接口
//
// 启用真实 API：
//   python scripts/prepare.py --with-ggml
//   prepare.py 会编译 ggml_native_wrapper.c 为静态库，
//   并在此文件追加 link(native(...)) 配置（见下方注释块）。
//
// 真实链接配置模板（由 prepare.py 自动追加，勿手动编辑）：
//   link(
//     native(
//       "stub-cc-flags": "-DEMBIT_HAS_GGML",
//       "cc-link-flags": "-L./lib -lembit_ggml -lggml -lgguf",
//     )
//   )

supported_targets = "native"

import {
  "walkzzz/embit/embit-core" @core,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/debug",
}

options(
  "native-stub": [ "ggml_stub.c" ],
)
